<!-- สคริปบาลี-->

<script>
let paliDict = [];

fetch('/assets/data/pali.json')
  .then(res => res.json())
  .then(data => {
    paliDict = data;
  })
  .catch(() => {
    document.getElementById('paliResult').innerText = "❌ โหลดไม่สำเร็จ";
  });

document.getElementById('paliInput').addEventListener('input', function () {
  const input = this.value.trim().toLowerCase();
  const resultBox = document.getElementById('paliResult');

  if (!input) {
    resultBox.innerHTML = '';
    return;
  }

  const matches = paliDict.filter(entry =>
    entry.headword.toLowerCase().includes(input)
  );

  resultBox.innerHTML = matches.length
    ? matches.slice(0, 10).map(entry => `<p><strong>${entry.headword}</strong>: ${entry.content}</p>`).join('')
    : `❌ ไม่พบคำว่า "<strong>${input}</strong>"`;
});
</script>



